{
  "permissions": {
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh label create:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(python3 -I .claude/skills/create-issue/check_issue.py:*)",
      "Bash(uv run coverage:*)",
      "Bash(uv run python .claude/skills/check-in-browser/browser_check.py:*)",
      "Bash(uv run python .claude/skills/build-verify-report/build_report.py:*)",
      "Bash(python3 -I .claude/skills/share-report/share_gate.py:*)",
      "Bash(uv run python .claude/skills/capture-before-after/before_after.py:*)",
      "Bash(uv run python .claude/skills/draft-pull-request/draft_pr.py:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(uv run python manage.py:*)"
    ],
    "ask": [
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh api:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo fork:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth switch:*)",
      "Bash(gh auth setup-git:*)",
      "Bash(gh gist:*)",
      "Bash(gh ssh-key:*)",
      "Bash(gh gpg-key:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh org:*)",
      "Bash(gh codespace:*)",
      "Bash(gh extension:*)",
      "Bash(gh search:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Edit(./.git/**)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Read(**/*DO-NOT-OPEN*)"
    ]
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "GH_REPO": "hungle-agilityio/ai-training"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-github-command-check.py\""
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-commit-check.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-edit-check.py\""
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-artifact-publish.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-finish-check.py\""
          }
        ]
      }
    ]
  }
}
