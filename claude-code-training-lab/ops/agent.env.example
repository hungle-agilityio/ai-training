# Copy to ops/agent.env (git-ignored, never committed) and edit. If ops/agent.env is missing, the
# loop reads agent.env in the state folder from ops/flow.toml (~/.reviewradar for ReviewRadar).

# Builds at once, a whole number from 1 to 3. Missing: 1. The Mac mini uses 2.
AGENT_CONCURRENCY=2

# Optional ntfy.sh topic for every loop message (see ops/README.md, "Phone messages").
# Empty or missing: no notifications. Pick a long random name; anyone who knows it can read it.
NTFY_TOPIC=

# Optional Slack Incoming Webhook URL; every message also goes there. It is a secret:
# keep it only in agent.env in the state folder, never in the repository or a log.
SLACK_WEBHOOK_URL=

# The password of the live.username account on the live site (the demo password set on Render); used only by ops/live_check.py.
LIVE_CHECK_PASSWORD=

# Secret. Render Account settings > API keys; used only by ops/rollback.py. Never commit it.
RENDER_API_KEY=

# srv-..., from the service's page on Render; used only by ops/rollback.py.
RENDER_SERVICE_ID=
