{
  "description": "The guards of the agent-flow loop: GitHub repository and publish guard, commit check, edit guard, report sharing gate, checks before finishing, format after edits, and the plugin's own skill scripts without a prompt.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-github-command-check.py\""
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-commit-check.py\""
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-skill-script-allow.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-edit-check.py\""
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-artifact-publish.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/before-finish-check.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/after-edit-format.py\""
          }
        ]
      }
    ]
  }
}
